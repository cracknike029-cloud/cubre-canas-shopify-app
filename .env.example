# Shopify
SHOPIFY_SHOP=TU-TIENDA.myshopify.com
SHOPIFY_ACCESS_TOKEN=PEGA_AQUI_EL_TOKEN_PRIVADO
SHOPIFY_API_VERSION=2026-07
SHOPIFY_CURRENCY=PYG

# Producto
PRODUCT_NAME=Cubre Canas

# Configura aquí las 3 opciones de cantidad.
# Reemplaza los IDs por los GID reales de las variantes de Shopify.
PACKAGE_1_LABEL=1 unidad
PACKAGE_1_PRICE=0
PACKAGE_1_VARIANT_ID=gid://shopify/ProductVariant/REEMPLAZAR

PACKAGE_2_LABEL=2 unidades
PACKAGE_2_PRICE=0
PACKAGE_2_VARIANT_ID=gid://shopify/ProductVariant/REEMPLAZAR

PACKAGE_3_LABEL=3 unidades
PACKAGE_3_PRICE=0
PACKAGE_3_VARIANT_ID=gid://shopify/ProductVariant/REEMPLAZAR
